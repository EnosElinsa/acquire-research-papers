{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorDiscoverySpec",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "orcid": {
      "type": "string"
    },
    "dblp": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "affiliation": {
      "type": "string"
    },
    "coauthors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date_from": {
      "type": "string"
    },
    "date_to": {
      "type": "string"
    },
    "local_dir": {
      "type": "string"
    },
    "max_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "$id": "https://github.com/EnosElinsa/acquire-research-papers/schemas/author-spec.schema.json"
}
