{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EnosElinsa/acquire-research-papers/schemas/research-brief.schema.json",
  "title": "ResearchBrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "question_type", "research_question"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "mode": {"const": "research"},
    "question_type": {
      "type": "string",
      "enum": ["gap-analysis", "similar-work", "claim-citation", "related-work"]
    },
    "research_question": {"type": "string", "minLength": 1},
    "work_under_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario": {"type": "string"},
        "mechanism": {"type": "string"},
        "decisions": {"type": "array", "items": {"type": "string"}},
        "objectives": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1},
              "required_relation": {
                "type": "string",
                "enum": ["direct-support", "indirect-support", "contradicts", "qualifies", "background"]
              }
            }
          }
        ]
      }
    },
    "seed_papers": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "queries": {
      "description": "Extra keyword searches, run in addition to the planned ones.",
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "synonyms": {
      "description": "Alternative names of the studied topic; each runs as its own search.",
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_full_text_papers": {"type": "integer", "minimum": 1, "maximum": 100},
        "graph_seed_limit": {"type": "integer", "minimum": 0, "maximum": 20},
        "graph_neighbors_per_direction": {"type": "integer", "minimum": 1, "maximum": 100},
        "rows_per_query": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "years": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "integer"}}
          ]
        },
        "venues": {
          "description": "Venue names, ISSNs, or venue preset names such as T-RO.",
          "type": "array", "items": {"type": "string", "minLength": 1}
        },
        "include_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exclude_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "publication_types": {
          "description": "review: the source classifies the work as a review, or its title names a survey, review, overview, tutorial, or state of the art.",
          "type": "array", "uniqueItems": true, "items": {"enum": ["review"]}
        },
        "doi_prefixes": {
          "description": "Keep only DOIs under these prefixes, e.g. 10.1109 for IEEE.",
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^10\\.[0-9]{4,9}$"}
        },
        "title_terms": {
          "description": "Every entry must occur in the title; 'a|b' accepts either.",
          "type": "array", "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_narrative": {"type": "boolean", "default": false},
        "export_markdown": {"type": "boolean", "default": false}
      }
    }
  }
}
