{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EnosElinsa/acquire-research-papers/schemas/research-evidence-review.schema.json",
  "title": "ResearchEvidenceReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_id",
    "full_text_sha256",
    "markdown_sha256",
    "review_status",
    "summary",
    "reviewer",
    "records"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "selection_id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "full_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "markdown_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_status": {"enum": ["reviewed", "insufficient-text"]},
    "summary": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "pattern": "\\S"},
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": {
        "host": {"type": "string", "pattern": "\\S"},
        "model": {"type": "string", "pattern": "\\S"},
        "version": {"type": "string", "pattern": "\\S"}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "paper_id",
          "relation",
          "read_scope",
          "section",
          "page",
          "excerpt",
          "explanation"
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "paper_id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
          "relation": {
            "enum": [
              "direct-support",
              "indirect-support",
              "qualifies",
              "contradicts",
              "background"
            ]
          },
          "read_scope": {"const": "full-text"},
          "section": {"type": ["string", "null"]},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "excerpt": {"type": "string", "maxLength": 500},
          "explanation": {"type": "string", "minLength": 1},
          "strength": {"type": "string"},
          "uncertainty": {"type": "string"}
        }
      }
    }
  },
  "if": {
    "required": ["schema_version"],
    "properties": {"schema_version": {"const": 2}}
  },
  "then": {"required": ["executor"]},
  "else": {
    "properties": {"reviewer": {"const": "codex"}},
    "not": {"required": ["executor"]}
  }
}
