{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityReviewDecision",
  "type": "object",
  "required": ["identity", "input_sha256", "decision", "reason", "policy", "policy_version", "evidence", "reviewer"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "identity": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["accept", "reject", "pending"]},
    "reason": {"type": "string", "minLength": 1},
    "policy": {"enum": ["identity", "relevance"]},
    "policy_version": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reviewer": {"type": "string", "minLength": 1},
    "executor": {"type": "object", "required": ["host"], "properties": {"host": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "if": {"required": ["schema_version"], "properties": {"schema_version": {"const": 2}}},
  "then": {"required": ["executor"]},
  "additionalProperties": false
}
