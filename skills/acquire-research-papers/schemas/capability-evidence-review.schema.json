{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityFullTextReview",
  "type": "object",
  "required": ["schema_version", "reviewer", "executor", "policy", "policy_version", "reason", "full_text_sha256", "markdown_sha256", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "reviewer": {"type": "string", "minLength": 1},
    "executor": {"type": "object", "required": ["host"], "properties": {"host": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "policy": {"const": "fulltext"},
    "policy_version": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "full_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "markdown_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["claim_id", "paper_id", "relation", "read_scope", "section", "page", "excerpt", "explanation"], "properties": {
      "claim_id": {"type": "string", "minLength": 1},
      "paper_id": {"type": "string", "minLength": 1},
      "relation": {"enum": ["direct-support", "indirect-support", "qualifies", "contradicts", "background"]},
      "read_scope": {"const": "full-text"},
      "section": {"type": ["string", "null"]},
      "page": {"type": ["integer", "null"], "minimum": 1},
      "excerpt": {"type": "string", "minLength": 1, "maxLength": 500},
      "explanation": {"type": "string", "minLength": 1},
      "strength": {"type": "string"},
      "uncertainty": {"type": "string"}
    }, "additionalProperties": false}}
  },
  "additionalProperties": false
}
