    given-names: Zhiyuan
    alias: EnosElinsa
version: 0.15.0
date-released: "2026-11-04"
license: MIT
repository-code: "https://github.com/EnosElinsa/acquire-research-papers"
url: "https://github.com/EnosElinsa/acquire-research-papers"
keywords:
  - academic research
  - literature review
  - research papers
  - bibtex
  - corpus construction
  - agent skill
